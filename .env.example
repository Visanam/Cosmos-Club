# B1 — Neon runtime connection (already set privately in Vercel for Production and Preview).
DATABASE_URL=

# B1 — Neon direct connection used only by Drizzle migration commands.
DIRECT_DATABASE_URL=

# B1 — Scheduled-job bearer token. Generate and store only in Vercel.
CRON_SECRET=

# B1 — Upstash QStash credentials for later scheduled work.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# B1 — Canonical public site origin; no trailing slash.
APP_ORIGIN=

# B2 — Resend transactional email.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_INTERNAL_TO=

# B2 — Upstash Redis rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# B3 — Account and session security.
SESSION_SECRET=
PASSWORD_PEPPER=
ADMIN_TOKEN=

# B5 — Cloudflare R2 private storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
